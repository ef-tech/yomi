{
  "name": "yomi",
  "version": "0.18.1",
  "description": "ローカル Markdown ビューア — 2 ペイン UI + Mermaid + ライブリロード",
  "type": "module",
  "bin": {
    "yomi": "./bin/yomi.ts"
  },
  "scripts": {
    "start": "bun run bin/yomi.ts",
    "build": "bun run scripts/build-vendor.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "marked": "^18.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.3",
    "dompurify": "3.4.11",
    "jsdom": "^30.0.1",
    "mermaid": "11.16.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ef-tech/yomi.git"
  },
  "license": "MIT",
  "author": "ef-tech"
}
